# Required for live coaching.
GEMINI_API_KEY=

# Optional: Supabase for saved sessions. Without it, sessions are kept in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional model overrides (defaults shown).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Tried when the primary Live model cannot be reached (synchronous tool calls only).
GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview

# Microsoft Learn documentation search for the coach (official Microsoft Learn MCP server).
# Set to off to disable.
MICROSOFT_DOCS_MCP_URL=https://learn.microsoft.com/api/mcp?maxTokenBudget=3000

# Server limits
PORT=3000
# Comma-separated browser origins allowed to open the live socket. Defaults to http://localhost:PORT.
ALLOWED_ORIGINS=
# If set, clients must open the app with ?token=<value> (use this for any hosted demo).
ACCESS_TOKEN=
MAX_CONNECTIONS=20
SESSION_MAX_MINUTES=15
IDLE_TIMEOUT_SECONDS=120
