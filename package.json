{
  "name": "teolima",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "knowledge:build": "tsx scripts/knowledge/build.ts",
    "knowledge:verify": "tsx scripts/knowledge/verify.ts",
    "knowledge:checklists": "tsx scripts/knowledge/checklists.ts",
    "compile:example": "tsx scripts/compile-example.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "fflate": "0.8.3",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roughjs": "4.6.6",
    "vite": "6.4.6",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "autoprefixer": "10.6.2",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  },
  "description": "Voice architecture coach that sketches multi-agent systems on a whiteboard as you talk.",
  "engines": {
    "node": ">=20"
  }
}
